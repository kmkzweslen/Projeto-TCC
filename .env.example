
# Meta / Instagram OAuth (obrigatório para login)
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret
META_REDIRECT_URI= https://valda-repletive-nonnutritively.ngrok-free.dev/api/auth/instagram/callback

# JWT da API (altere em produção)
JWT_SECRET_KEY=uma-chave-secreta-longa-e-aleatoria

# Opcional: redirecionar após login (?redirect=true no callback)
FRONTEND_URL=http://localhost:3000

# Fallback legado (sem login) — opcional
IG_USER_ID=
USER_ACCESS_TOKEN=

# Cloud Storage (ImgBB)
IMGBB_API_KEY=sua_api_key_imgbb

# Stability AI (imagens)
STABILITY_AI_API_KEY=

# Gemini (opcional)
GEMINI_API_KEY=

# MongoDB (recomendado para persistir usuários e conteúdos)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=prototipo
